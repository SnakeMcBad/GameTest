; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the properties have different types.
;
; Format:
;   [section] ; section goes in []
;   project/settings/name = value ; value goes after =

config_version=5

[application]

config/name="Metroidvania"
config/description="A Metroidvania game inspired by Hollow Knight: Silksong"
run/main_scene="res://scenes/world/Main.tscn"
config/use_custom_user_dir=false
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"


[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemy"
2d_physics/layer_4="player_hitbox"
2d_physics/layer_5="player_hurtbox"
2d_physics/layer_6="enemy_hitbox"
2d_physics/layer_7="enemy_hurtbox"

[physics]

2d/default_gravity=980.0
